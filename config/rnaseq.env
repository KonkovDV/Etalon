# RNA-seq dataset definition for scripts/prepare_rnaseq_data.sh (sourced by bash).
# Every value can be overridden from the environment.

# --- Samples ------------------------------------------------------------------------
# Two commercial reference RNAs, three library replicates each, with ERCC ExFold
# spike-in mixes: UHR (Universal Human Reference RNA, 10 cancer cell lines) + ERCC
# Mix 1 and HBR (Human Brain Reference RNA, 23 donors) + ERCC Mix 2. Illumina
# HiSeq 2500 (HWI-ST718), 2x100, stranded; reads that aligned to chr22 or to the
# ERCC sequences, downsampled. Course data of Griffith et al., PLoS Comput Biol
# 2015 (rnabio.org); the same reference RNAs as MAQC/SEQC.
: "${RNASEQ_READS_URL:=https://genomedata.org/rnaseq-tutorial/HBR_UHR_ERCC_ds_5pc.tar}"
: "${RNASEQ_READS_SHA256:=8850392715718f5d12503b0f9e5b157199a4439df829b52a468ed1bf0ad84c27}"
# group|replicate|ERCC mix   (file names in the archive follow this pattern)
RNASEQ_SAMPLES=(
  "UHR|1|Mix1" "UHR|2|Mix1" "UHR|3|Mix1"
  "HBR|1|Mix2" "HBR|2|Mix2" "HBR|3|Mix2"
)

# --- Truth: ERCC spike-in concentrations ----------------------------------------------
# 92 synthetic transcripts over a 2^20 concentration range, four subgroups of 23 with
# Mix 1 / Mix 2 ratios 4, 1, 2/3 and 1/2 (Thermo Fisher, ERCC Controls Analysis).
: "${ERCC_TABLE_URL:=https://assets.thermofisher.com/TFS-Assets/LSG/manuals/cms_095046.txt}"
: "${ERCC_TABLE_SHA256:=5151b394332477301851404d37b907cb6f27c9aaa2569e288531a839d6ca2b3b}"
# ERCC92.fa and ERCC92.gtf: the sequences and their one-exon annotation
: "${ERCC_ZIP_URL:=https://assets.thermofisher.com/TFS-Assets/LSG/manuals/ERCC92.zip}"
: "${ERCC_ZIP_SHA256:=8d5f23e997248084cc210061f07f1a51c2f1bf49ea07ee08a9f78bf6ff074807}"

# --- Genome ---------------------------------------------------------------------------------
# chr22 of the GRCh38 no-alt analysis set: the same bgzip FASTA as the WGS reference,
# read over HTTPS through its index (only chr22 is transferred).
: "${RNASEQ_GENOME_URL:=https://storage.googleapis.com/deepvariant/case-study-testdata/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa.gz}"
: "${RNASEQ_CHROM:=chr22}"
# Independent check: length and M5 of chr22 in the Broad GRCh38 sequence dictionary
: "${RNASEQ_DICT_URL:=https://storage.googleapis.com/gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.dict}"

# --- Annotation -------------------------------------------------------------------------
# GENCODE release 50 (Ensembl 116), comprehensive, reference chromosomes; md5 from the
# release MD5SUMS file.
: "${RNASEQ_GTF_URL:=https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_50/gencode.v50.annotation.gtf.gz}"
: "${RNASEQ_GTF_MD5:=2d273848c6068682fabea72fae4896a9}"

# --- Output ---------------------------------------------------------------------------------
: "${RNASEQ_DIR:=data/rnaseq}"
: "${RNASEQ_CACHE:=${RNASEQ_DIR}/cache}"
