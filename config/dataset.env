# Dataset definition for scripts/prepare_data.sh (sourced by bash).
# Every value can be overridden from the environment: REGION_END=10500000 make data

# --- Sample -------------------------------------------------------------------
# HG002 = NA24385 = huAA53E0, son of the Ashkenazi Jewish trio (PGP), the most
# thoroughly characterised GIAB reference material (NIST RM 8391).
: "${SAMPLE:=HG002}"

# --- Region (1-based, inclusive, GRCh38) -----------------------------------------
# chr20:10.0-12.0 Mb. Chosen because it (1) holds clinically relevant genes:
# SNAP25, MKKS (Bardet-Biedl / McKusick-Kaufman), JAG1 (Alagille syndrome);
# (2) contains both "easy" sequence and GIAB difficult strata (homopolymers,
# tandem repeats, low mappability), so stratified metrics are not empty;
# (3) chr20 is the community's standard benchmarking chromosome (DeepVariant,
# precisionFDA), so numbers are comparable with published ones.
: "${REGION_CHROM:=chr20}"
: "${REGION_START:=10000001}"
: "${REGION_END:=12000000}"
# Benchmark intervals are trimmed by this margin at both ends: reads were taken
# from the region only, so depth tapers over ~one insert size near the edges.
: "${EDGE_MARGIN:=2000}"

# --- Reads ------------------------------------------------------------------------
# Illumina NovaSeq 6000, PCR-free, 2x151, ~35x, aligned to GRCh38 no-alt
# (public DeepVariant case-study data, Google Cloud). Reads are pulled back to
# FASTQ, so the pipeline starts from raw reads exactly as in production.
: "${READS_BAM_URL:=https://storage.googleapis.com/deepvariant/case-study-testdata/HG002.novaseq.pcr-free.35x.dedup.grch38_no_alt.chr20.bam}"

# --- Reference ----------------------------------------------------------------------
# GRCh38 no-alt analysis set (GCA_000001405.15): the build GIAB benchmarks use.
# bgzip-compressed with .fai/.gzi, so samtools faidx reads only the region.
: "${REFERENCE_URL:=https://storage.googleapis.com/deepvariant/case-study-testdata/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa.gz}"
# Independent cross-check of the extracted sequence (UCSC REST API, hg38).
: "${UCSC_API:=https://api.genome.ucsc.edu/getData/sequence}"

# --- Truth sets (GIAB, NIST) ---------------------------------------------------------
GIAB_HG002=https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/AshkenazimTrio/HG002_NA24385_son
# v5.0q: assembly-based (HG002 Q100 / T2T-HG002 v1.1 via DeFrABB). Current GIAB
# recommendation; v4.2.1 is marked deprecated for HG002. Covers harder regions.
: "${TRUTH_V5_VCF:=${GIAB_HG002}/v5.0q/HG002_GRCh38_v5.0q_smvar.vcf.gz}"
: "${TRUTH_V5_BED:=${GIAB_HG002}/v5.0q/HG002_GRCh38_v5.0q_smvar.benchmark.bed}"
# v4.2.1: mapping/integration-based, the long-standing community standard.
# Kept for comparability with the literature of 2020-2025.
: "${TRUTH_V421_VCF:=${GIAB_HG002}/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz}"
: "${TRUTH_V421_BED:=${GIAB_HG002}/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed}"

# --- GIAB genome stratifications v3.6 (Dwarshuis et al., Nat Commun 2024) ----------
: "${STRAT_BASE:=https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/genome-stratifications/v3.6/GRCh38@all}"
# name|relative path. md5 sums are checked against the release md5 list.
STRATIFICATIONS=(
  "all_difficult|Union/GRCh38_alldifficultregions.bed.gz"
  "not_in_all_difficult|Union/GRCh38_notinalldifficultregions.bed.gz"
  "homopolymers_ge7|LowComplexity/GRCh38_AllHomopolymers_ge7bp_imperfectge11bp_slop5.bed.gz"
  "tandem_repeats|LowComplexity/GRCh38_AllTandemRepeats.bed.gz"
  "low_mappability|Mappability/GRCh38_lowmappabilityall.bed.gz"
  "segdups|SegmentalDuplications/GRCh38_segdups.bed.gz"
  "gc_lt25_or_gt65|GCcontent/GRCh38_gclt25orgt65_slop50.bed.gz"
  "refseq_cds|Functional/GRCh38_refseq_cds.bed.gz"
)

# --- Output -------------------------------------------------------------------------
: "${DATA_DIR:=data}"
: "${CACHE_DIR:=${DATA_DIR}/cache}"
